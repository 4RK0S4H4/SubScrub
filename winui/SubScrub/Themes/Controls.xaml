        <Setter Property="BorderBrush" Value="{ThemeResource S4FieldLineBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource S4AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0,12,1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{StaticResource S4FontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PasswordRevealMode" Value="Hidden" />
