<!--
    S4 Glass for WinUI: fonts, text styles and a template for every control SubScrub uses, so nothing looks like a
    stock Fluent control. Colours come only from Tokens.xaml (generated from subscrub/ui/theme.py), always through
    ThemeResource so light and dark switch live. Rules (CLAUDE.md "Look"): crimson only on the primary button,
    switches, the selected tab, segment or nav item and things that need checking; hover and selection are soft
    fills, never outlines; keyboard focus shows the system ring (UseSystemFocusVisuals), which appears for
    keyboard focus only.

    Fonts: each Inter weight is its own family (tools/make_winui.py), so set FontFamily, never FontWeight.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ================================================================ type -->

    <FontFamily x:Key="S4FontRegular">ms-appx:///Assets/Fonts/Inter-Regular.ttf#SubScrub Inter Regular</FontFamily>
    <FontFamily x:Key="S4FontMedium">ms-appx:///Assets/Fonts/Inter-Medium.ttf#SubScrub Inter Medium</FontFamily>
    <FontFamily x:Key="S4FontSemiBold">ms-appx:///Assets/Fonts/Inter-SemiBold.ttf#SubScrub Inter SemiBold</FontFamily>
    <FontFamily x:Key="S4FontBold">ms-appx:///Assets/Fonts/Inter-Bold.ttf#SubScrub Inter Bold</FontFamily>
    <FontFamily x:Key="S4FontItalic">ms-appx:///Assets/Fonts/Inter-Italic.ttf#SubScrub Inter Italic</FontFamily>
    <!-- what Fluent's own pieces (menus, tooltips) use -->
    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/Inter-Regular.ttf#SubScrub Inter Regular</FontFamily>

    <Style x:Key="S4Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource S4FontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource S4TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="S4Hint" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource S4Text2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="S4Quiet" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource S4Text2Brush}" />
    </Style>
    <Style x:Key="S4Medium" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontMedium}" />
    </Style>
    <Style x:Key="S4PageTitle" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontSemiBold}" />
        <Setter Property="FontSize" Value="21" />
    </Style>
    <Style x:Key="S4CardTitle" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontSemiBold}" />
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="S4FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontMedium}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource S4Text2Brush}" />
    </Style>
    <Style x:Key="S4Count" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontSemiBold}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ================================================================ surfaces -->

    <!-- frosted card: glass fill, hairline border with a lit top edge -->
    <Style x:Key="S4Card" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource S4GlassBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource S4CardEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- the track behind a segmented control (tabs, choices) -->
    <Style x:Key="S4SegTrack" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource S4SegTrackBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource S4SegLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- a status badge: hugs its text; the row picks the colours (ok / warn / bad) -->
    <Style x:Key="S4Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2,9,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="S4BadgeText" TargetType="TextBlock" BasedOn="{StaticResource S4Text}">
        <Setter Property="FontFamily" Value="{StaticResource S4FontSemiBold}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- ================================================================ buttons -->

    <!-- plain button: glass with a hairline; hover and press are a faint accent tint -->
    <Style x:Key="S4Button" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource S4Glass2Brush}" />
        <Setter Property="Foreground" Value="{ThemeResource S4TextBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource S4Border2Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,0,14,1" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource S4FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4HovBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4PressBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="Tint" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S4SmallButton" TargetType="Button" BasedOn="{StaticResource S4Button}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0,12,1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- text-only button (Clear List, Restore Defaults) -->
    <Style x:Key="S4SubtleButton" TargetType="Button" BasedOn="{StaticResource S4Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12,0,12,1" />
    </Style>

    <!-- icon-only button (top bar, close) -->
    <Style x:Key="S4IconButton" TargetType="Button" BasedOn="{StaticResource S4Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource S4Text2Brush}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- the one primary (accent-filled) button per area. Dark mode: a faint diffuse backlight; light: a soft
         accent shadow. Neither is a ring. -->
    <Style x:Key="S4PrimaryButton" TargetType="Button" BasedOn="{StaticResource S4Button}">
        <Setter Property="Background" Value="{ThemeResource S4BtnBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource S4BtnFgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource S4BtnEdgeBrush}" />
        <Setter Property="Padding" Value="16,0,16,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource S4BtnHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource S4BtnPressBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Chrome.Background" Value="{ThemeResource S4BtnDisabledBrush}" />
                                        <Setter Target="Glow.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Glow" Margin="-16,-8,-16,-16" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="0.5,0.56" RadiusX="0.5" RadiusY="0.5" GradientOrigin="0.5,0.56">
                                    <GradientStop Offset="0.45" Color="{ThemeResource S4PrimaryGlowColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource S4PrimaryGlowEdgeColor}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ segmented control and tabs -->

    <!-- one option of a segmented control: the selected one is a crimson pill with white text -->
    <Style x:Key="S4SegItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource S4TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource S4FontMedium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="16,0,16,1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4HovBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4PressBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Sel.Opacity" Value="1" />
                                        <Setter Target="Glow.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource S4BtnFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Glow" Margin="-8,-6,-8,-8" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.5" Color="{ThemeResource S4SegGlowColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource S4ClearColor}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="Sel" Background="{ThemeResource S4BtnBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="Tint" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- settings sections: the selected one is the accent gradient with a white label and icon -->
    <Style x:Key="S4NavItem" TargetType="RadioButton" BasedOn="{StaticResource S4SegItem}">
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0,12,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4HovBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Tint.Background" Value="{ThemeResource S4PressBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Sel.Opacity" Value="1" />
                                        <Setter Target="Glow.Opacity" Value="1" />
                                        <Setter Target="Tint.Opacity" Value="0" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource S4BtnFgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="Glow" Margin="-6,-4,-6,-8" Opacity="0" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0.55" Color="{ThemeResource S4NavGlowColor}" />
                                    <GradientStop Offset="1" Color="{ThemeResource S4ClearColor}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Border x:Name="Sel" Background="{ThemeResource S4NavBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="Tint" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ switch -->

    <!-- the Fluent ToggleSwitch's parts and states, drawn the S4 way: crimson track and white knob when on -->
    <Style x:Key="S4Toggle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource S4TextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterBorder.Stroke" Value="{ThemeResource S4FieldFocusLineBrush}" />
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource S4BtnHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchKnobBounds.Fill" Value="{ThemeResource S4BtnPressBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchArea.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition x:Name="DraggingToOnTransition" From="Dragging" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOnOffset}" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToDraggingTransition" From="On" To="Dragging" GeneratedDuration="0">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="DraggingToOffTransition" From="Dragging" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobCurrentToOffOffset}" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OnToOffTransition" From="On" To="Off" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOnToOffOffset}" />
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition x:Name="OffToOnTransition" From="Off" To="On" GeneratedDuration="0">
                                        <Storyboard>
                                            <RepositionThemeAnimation TargetName="SwitchKnob" FromHorizontalOffset="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TemplateSettings.KnobOffToOnOffset}" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.083" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.083" />
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobOff" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent" />
                                <VisualState x:Name="OnContent" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="HeaderContentPresenter" Grid.Row="0" Visibility="Collapsed"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                        <Grid x:Name="SwitchArea" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Grid x:Name="SwitchAreaGrid" Margin="-4" Background="Transparent" Control.IsTemplateFocusTarget="True" />
                            <ContentPresenter x:Name="OffContentPresenter" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}"
                                              AutomationProperties.AccessibilityView="Raw" />
                            <ContentPresenter x:Name="OnContentPresenter" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}"
                                              AutomationProperties.AccessibilityView="Raw" />
                            <Rectangle x:Name="OuterBorder" Width="40" Height="22" RadiusX="11" RadiusY="11"
                                       Fill="{ThemeResource S4MuteBgBrush}" Stroke="{ThemeResource S4Border2Brush}" StrokeThickness="1" />
                            <Rectangle x:Name="SwitchKnobBounds" Width="40" Height="22" RadiusX="11" RadiusY="11"
                                       Fill="{ThemeResource S4BtnBrush}" Opacity="0" />
                            <Grid x:Name="SwitchKnob" Width="22" Height="22" HorizontalAlignment="Left">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                                <Ellipse x:Name="SwitchKnobOn" Width="16" Height="16" Fill="{ThemeResource S4WhiteBrush}" Opacity="0" />
                                <Ellipse x:Name="SwitchKnobOff" Width="14" Height="14" Fill="{ThemeResource S4KnobOffBrush}" />
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ fields -->

    <Style x:Key="S4TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{ThemeResource S4TextBrush}" />
        <Setter Property="Background" Value="{ThemeResource S4FieldBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource S4FieldLineBrush}" />
        <Setter Property="SelectionHighlightColor" Value="{ThemeResource S4AccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0,12,1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FontFamily" Value="{StaticResource S4FontRegular}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="RootGrid">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource S4FieldFocusLineBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource S4FieldFocusLineBrush}" />
                                        <Setter Target="BorderElement.Background" Value="{ThemeResource S4FieldFocusBgBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.45" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <ScrollViewer x:Name="ContentElement"
                                      Margin="{TemplateBinding BorderThickness}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalScrollMode="{TemplateBinding ScrollViewer.HorizontalScrollMode}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      IsHorizontalRailEnabled="False"
                                      IsVerticalRailEnabled="False"
                                      ZoomMode="Disabled"
                                      IsTabStop="False"
                                      AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="PlaceholderTextContentPresenter"
                                   Margin="{TemplateBinding BorderThickness}"
                                   Padding="{TemplateBinding Padding}"
                                   VerticalAlignment="Center"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{ThemeResource S4Text3Brush}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

