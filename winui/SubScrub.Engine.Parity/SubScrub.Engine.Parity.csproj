<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the C# engine on the cases frozen from the retired Python engine (tests/golden) and compares what it gets,
       with the differences listed. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- full Unicode (normalization), as in the app -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubScrub.Engine\SubScrub.Engine.csproj" />
  </ItemGroup>
</Project>
