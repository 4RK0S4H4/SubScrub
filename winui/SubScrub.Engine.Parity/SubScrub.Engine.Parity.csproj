<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the C# engine on the cases tools/cleaner_parity.py recorded from the Python engine and writes what it got,
       for the script to compare. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SubScrub.Engine\SubScrub.Engine.csproj" />
  </ItemGroup>
</Project>
